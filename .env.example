# Copy this file to .env and adjust values for your local environment.
# Never commit the real .env file.
# This file is only for Docker/local SQL Server container configuration.
# The API's ConnectionStrings:FleetFlow value is configured via .NET User Secrets
# (or the ConnectionStrings__FleetFlow environment variable in deployed environments),
# never via .env — see the "Database Configuration" section in README.md.

# SA password for the local SQL Server container. Must satisfy SQL Server's
# complexity policy (8+ chars, upper/lower/digit/symbol).
MSSQL_SA_PASSWORD=Your_local_password123
